# Copy to .env and fill with your Firebase web-app config. Never commit .env.
# NOTE: Vite exposes env vars through import.meta.env and requires the VITE_ prefix
# (this is Vite's equivalent of process.env in CRA / Next.js).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
